<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep dark base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0D1B27"
                android:endColor="#132030"
                android:angle="135"
                android:type="linear" />
        </shape>
    </item>
    <!-- Subtle top border glow -->
    <item android:top="0dp" android:bottom="218dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A2E42" />
        </shape>
    </item>
</layer-list>
